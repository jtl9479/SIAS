//기관정보 초기화
function fn_custInfoDefalut(data) {
	
	$.each ($("div[data-cust="+ data +"]").find("dd"), function(idx, dom) {
		
		var domObject = $(dom).find("label[class*=radio]");

		// radio
		if (domObject.length > 0) {
			domObject.find("input").prop("checked", false);
			domObject.find("input").eq(0).prop("checked", true);
			
	    } else {
			$(dom).find("input").val("");
	    }
	});
}


