function fn_chkInfo(data) {
	// 선택된 체크박스 이름과 체크속성 정보
	var object = $(data).find("input[name*=INFO_SET]"),
		jsName = object.attr("name"),
		jsStatus = object.prop("checked"),
		jsDataSet = $(object).data("set");

	if (!gfn_isNull(jsName)) {
		// 동일한 이름의 체크박스 초기화
		if (!gfn_isNull(jsDataSet)) { 
			$("input[name*=" + jsName + "][data-set!=" + jsDataSet + "]").prop("checked", false);	
		}
		// 원하는 기관의 대한 정보를 표출
		if (jsStatus) {
			//의뢰기관 및 성적서업체와 동일 키 이벤트
			fn_custInfoCopy(object[0]);
			
		} else {
			var jsKey = jsName.split("_")[0];
			// 기관정보 초기화
			fn_custInfoDefalut(jsKey);
		}
	}
}



