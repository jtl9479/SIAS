//파일다운로드
function fn_downFileChk(fileColName, fileNum, fileType, viewSeq)
{
	var jsNM = fileColName+"_NM";	
	var jsPT = fileColName+"_PT";	
	var jsSeq = viewSeq;
	
	if (fileNum != "0") {
		jsNM = jsNM +"_"+fileNum;
		jsPT = jsPT + "_"+fileNum;
	}
	
	var jsFileName = $("#"+jsNM).val();
	var jsFilePath = $("#"+jsPT).val();
	var ext = jsFileName.split('.').pop().toUpperCase();
	
	if(gfn_isNull(fileType)) fileType = "";
	if(gfn_isNull(viewSeq)) viewSeq = "0";
	
	// fileType 값이 D인 경우에는 데이터컬럼으로 이름만 확인
	if(fileType == "D"){
		if (gfn_isNull(jsFileName) ) {
			alertBox('파일정보 확인을 실패하였습니다.');
			return;
		}
	} else {
		if (gfn_isNull(jsFileName) || gfn_isNull(jsFilePath)) {
			alertBox('파일정보 확인을 실패하였습니다.');
			return;
		}
	}

	//이미지의 경우 팝업열기, 문서는 다운로드
	if($.inArray(ext, ['GIF','PNG','JPG','JPEG']) == -1) {
		// 파일 다운로드
		fn_fileDown(jsFileName, jsFilePath)
	} else {
		// 팝업에 이미지 표시
		fn_popImgView(jsFileName, jsFilePath, fileType, fileColName, jsSeq);
	}
}


