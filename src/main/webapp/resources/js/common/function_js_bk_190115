function fn_numberFormat(obj) {
	obj.value = fn_comma(fn_uncomma(obj.value));
}

//숫자 콤마 찍기
function fn_comma(str) {
  str = String(str);
  return str.replace(/(\d)(?=(?:\d{3})+(?!\d))/g, '$1,');
}


//숫자 콤마 풀기
function fn_uncomma(str) {
  str = String(str);
  return str.replace(/[^\d]+/g, '');
}

