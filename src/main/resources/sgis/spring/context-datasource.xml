<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" 
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns:jdbc="http://www.springframework.org/schema/jdbc"
		xsi:schemaLocation="http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
        http://www.springframework.org/schema/jdbc  
        http://www.springframework.org/schema/jdbc/spring-jdbc-4.0.xsd">
	
	<!-- context-common.xml 에 util:properties 선언으로주석처리 20181206_SGIS_YW
	<bean id="propertyConfigurer" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
         <property name="locations">
            <list>
                <value>classpath:/sgis/props/globals.properties</value>
            </list>
        </property>
    </bean>
    <bean id="dataSourceSpied" class="org.apache.commons.dbcp.BasicDataSource">
        <property name="driverClassName" value="${Globals.DriverClassName}"/>
        <property name="url" value="${Globals.Url}" />
        <property name="username" value="${Globals.UserName}"/>
        <property name="password" value="${Globals.Password}"/>
    </bean> -->
    
    <bean id="dataSourceSpied" class="org.apache.commons.dbcp.BasicDataSource">
        <property name="driverClassName" value="#{globals['Globals.DriverClassName']}"/>
        <property name="url" value="#{globals['Globals.Url']}" />
        <property name="username" value="#{globals['Globals.UserName']}"/>
        <property name="password" value="#{globals['Globals.Password']}"/>
    </bean>
    
    <bean id="dataSource" class="net.sf.log4jdbc.Log4jdbcProxyDataSource">
		<constructor-arg ref="dataSourceSpied" />
		<property name="logFormatter">
			<bean class="net.sf.log4jdbc.tools.Log4JdbcCustomFormatter">
				<property name="loggingType" value="MULTI_LINE" />
				<property name="sqlPrefix" value="SQL         :  "/>
			</bean>
		</property>
	</bean>
    
    
</beans>
